{
  "_about": "Synthetic encounter-summary evaluation corpus (docs/19 §8). No real patients. Each case drives the real API: typed intake through the fake provider (a keyword extractor, NOT an LLM), replayed OCR documents with explicit human review actions, and an optional triage run. `expect` holds the gold labels for the summary stage only. Small and hand-written: a regression and safety check, not evidence of clinical accuracy.",
  "cases": [
    {"id": "duration_digits", "texts": ["Fever for 3 days."], "expect": {"duration": "3 days", "present": ["fever"], "linked": "fever"}},
    {"id": "duration_words", "texts": ["Fever for three days with cough."], "expect": {"duration": "3 days", "present": ["fever", "cough"], "linked": null}},
    {"id": "duration_weeks_single_symptom", "texts": ["Headache for 2 weeks."], "expect": {"duration": "2 weeks", "present": ["headache"], "linked": "headache"}},
    {"id": "multi_symptom_sentence_with_negation", "texts": ["Fever, headache and vomiting since 2 days. No chest pain."],
     "expect": {"duration": "2 days", "present": ["fever", "headache", "vomiting"], "denied": ["chest pain"]}},
    {"id": "missing_duration", "texts": ["Cough and weakness."], "expect": {"duration": null, "present": ["cough", "weakness"], "missing_includes": ["duration"]}},
    {"id": "contradictory_durations", "texts": ["Fever for 3 days.", "Fever for 1 week."], "expect": {"conflicts": ["duration"], "duration_not_in_prose": ["3 days", "1 week"]}},
    {"id": "vitals_conflict_text_vs_form", "texts": ["SpO2 91%."], "triage": {"spo2": 97}, "expect": {"vitals": {"spo2": "conflict"}, "conflicts": ["spo2"]}},
    {"id": "vitals_agree_text_and_form", "texts": ["BP 120/80."], "triage": {"sbp": 120, "dbp": 80}, "expect": {"vitals": {"bp": "120/80 mmHg"}, "conflicts": []}},
    {"id": "temperature_fahrenheit", "texts": ["Temperature 102 F."], "expect": {"vitals": {"temp_c": "38.9 °C (said as 102 °F)"}}},
    {"id": "temperature_unit_missing", "texts": ["Temperature 101."], "expect": {"vitals_absent": ["temp_c"], "pending_states": ["unit_missing"]}},
    {"id": "no_triage_run", "texts": ["Cough for 5 days."], "expect": {"urgency": null, "missing_includes": ["red_flag_screen", "spo2"]}},
    {"id": "triage_form_only", "texts": [], "triage": {}, "expect": {"vitals": {"spo2": "98%", "pulse": "78 /min"}, "urgency_from_rules": true}},
    {"id": "lab_reviewed_and_corrected", "texts": ["Fever for 3 days."], "triage": {},
     "docs": [{"fixture": "cbc_low_platelet.png", "type": "lab_report", "attest": true, "review": {"hemoglobin": "confirmed", "rbc": ["corrected", {"result": {"value": "4.20"}}]}}],
     "expect": {"labs": {"hemoglobin": "11.2 g/dL", "rbc": "4.20"}, "labs_unchecked_not_in_prose": ["platelets"]}},
    {"id": "lab_unattested", "texts": ["Fever for 3 days."],
     "docs": [{"fixture": "cbc_low_platelet.png", "type": "lab_report", "attest": false}], "expect": {"labs_count": 0, "pending_states": ["attestation_missing"]}},
    {"id": "duplicate_document", "texts": [],
     "docs": [{"fixture": "cbc_low_platelet.png", "type": "lab_report", "attest": true, "review": {"hemoglobin": "confirmed"}},
              {"fixture": "cbc_low_platelet.png", "type": "lab_report", "attest": true, "review": {"hemoglobin": "confirmed"}}],
     "expect": {"lab_rows": {"hemoglobin": 1}, "lab_sources": {"hemoglobin": 2}}},
    {"id": "rx_clear_and_ambiguous_handwriting", "texts": ["Fever for 3 days."], "triage": {},
     "docs": [{"fixture": "rx_handwritten.png", "type": "prescription", "engines": "rx_handwritten", "attest": true, "review": {"Pantoprazole": "confirmed"}}],
     "expect": {"meds_in_prose": ["Pantoprazole 40 mg"], "meds_abstained": ["Amoxicillin", "Paracetamol", "Ambroxol"], "uncertain_flagged": ["Amoxicillin"]}},
    {"id": "rx_rejected_line", "texts": [],
     "docs": [{"fixture": "rx_handwritten.png", "type": "prescription", "engines": "rx_handwritten", "attest": true, "review": {"Amoxicillin": "rejected"}}],
     "expect": {"meds_absent": ["Amoxicillin"]}},
    {"id": "ai_consent_declined", "texts": [], "ai_consent": false, "triage": {}, "expect": {"excluded": ["ai_extraction"], "status": "complete"}}
  ]
}
