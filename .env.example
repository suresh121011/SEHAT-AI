# ============================================================
# SEHAT AI — Environment Variables Example
# Copy this file to .env and fill in real values
# ============================================================

# --- Azure OpenAI (Primary LLM) ---
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Voice pipeline (Phase 4, optional; docs/12_Voice_Pipeline.md) ---
# Everything is OFF by default. A disabled component is never loaded or called.
VOICE_ENABLED=0
VOICE_VAD_ENABLED=1                # Silero VAD (needs backend/requirements-voice.txt)
VOICE_LOCAL_ASR_ENABLED=0          # IndicConformer-600M on this machine (hi/or; model downloaded explicitly)
VOICE_LOCAL_MODEL_DIR=./models/voice
VOICE_CLOUD_STT_ENABLED=0          # Sarvam Saaras v4 — also needs per-case `voice_cloud` consent
VOICE_TTS_ENABLED=0                # Sarvam Bulbul v3 spoken read-back — also needs `voice_cloud` consent
VOICE_MAX_SECONDS=30
# Sarvam may retain content up to 30 days and use it for training unless your organisation opts out
# (check your Sarvam dashboard). Use synthetic audio only in this prototype.
SARVAM_API_KEY=your_sarvam_api_key_here
# Must be https://api.sarvam.ai (allowlisted in backend/app/config.py); anything else refuses to start.
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_S=20

# --- Authentication ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_PATH=./sehat.db

# --- CORS & Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OCR Pipeline (optional) ---
OCR_ENABLED=0
OCR_SURYA_ENABLED=0
OCR_CHANDRA_ENABLED=0
OCR_RETENTION_DAYS=none
