# ============================================================
# SEHAT AI — Environment Variables Example
# Copy this file to .env and fill in real values
# ============================================================

# --- Azure OpenAI (used only when AI_PROVIDER=azure; see the AI section below) ---
# Example values only: no Azure deployment has been run with this build (docs/16 §7).
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- AI extraction (Phase 6; docs/16_LLM_Extraction_MAKER.md) ---
# none = no model is called (AI endpoints answer 503). fake = deterministic keyword extractor, NOT an LLM
# (offline demo/dev). azure = Azure OpenAI via Semantic Kernel. local = open model on this machine (below).
# Never falls back from one provider to another.
AI_PROVIDER=none
# AI_FAKE_MODE=demo_disagreement   # fake only: pass 2 disagrees on one value, to show a disputed field
AI_MAKER_PASSES=3                  # 3–5 passes; disagreement goes to a human (passes share the model's errors)
# AI_TIMEOUT_S=30                  # default 30 s; 60 s when AI_PROVIDER=local (set explicitly to override)
# Azure checklist (docs/16 §7) — ALL required for AI_PROVIDER=azure, otherwise the server refuses to start:
#   AI_CLOUD_ENABLED=1                 redacted case text leaves this machine
#   AI_CLOUD_SYNTHETIC_DATA_ONLY=1     acknowledgement: PII redaction has known misses; synthetic data only
#   AZURE_OPENAI_API_KEY / _ENDPOINT (https://<resource>.openai.azure.com/) / _DEPLOYMENT_NAME / _API_VERSION
#   a deployment and API version that support structured outputs (json_schema, strict)
AI_CLOUD_ENABLED=0
AI_CLOUD_SYNTHETIC_DATA_ONLY=0
# Deterministic red-flag keyword suggester (docs/16 §2c): candidates labelled "Keyword rule — not AI model output",
# per-field human review, never ticked automatically. Runs with every provider. On by default.
AI_KEYWORD_RED_FLAGS=1
# Local Hindi/Odia → English (IndicTrans2; gated model, explicit download, backend/requirements-translation.txt).
# Accept the terms on huggingface.co first (403 GatedRepoError until access is granted), then from backend/:
#   ../.venv/bin/python scripts/download_translation_models.py     (~0.9 GB, pinned revision, SHA-256 manifest)
TRANSLATION_ENABLED=0
TRANSLATION_MODEL_DIR=./models/translation
# Local open-weights model (docs/16 §2a) for AI_PROVIDER=local. Case text stays on this machine (still redacted first).
#   ../.venv/bin/python scripts/download_local_llm.py qwen3-4b-instruct-2507-q4km    (from backend/; ~2.5 GB, Apache-2.0)
#   ../.venv/bin/python scripts/start_local_llm.py                                  (separate terminal; loopback only)
# The model is general-purpose, NOT a medical model. AI_TIMEOUT_S defaults to 60 for local (3 passes share the GPU).
# LOCAL_LLM_MODEL=qwen3-4b-instruct-2507-q4km     # or gemma-4-e4b-it-q4_0 / gemma-4-e2b-it-q4_0 (see --list)
# LOCAL_LLM_MODEL_DIR=./models/llm
# LOCAL_LLM_URL=http://127.0.0.1:8091             # loopback only; anything else refuses to start
# NeMo Guardrails layer around extraction (docs/16 §2b): uv pip install -r backend/requirements-guardrails.txt
# Runs our own deterministic input/output detectors through NeMo rails; no LLM, telemetry forced off. Fails closed:
# a hit blocks the WHOLE extraction (422 GUARDRAIL_BLOCKED, nothing stored, audited as reason code only); a rail error
# is 503. RECOMMENDED FOR DEMOS (1). The code default is 0 so the app runs without the optional package; with 1 and the
# package missing, the server refuses to start and prints the install command (no silent skip).
GUARDRAILS_ENABLED=1

# --- Voice pipeline (Phase 4, optional; docs/12_Voice_Pipeline.md) ---
# Everything is OFF by default. A disabled component is never loaded or called.
VOICE_ENABLED=0
VOICE_VAD_ENABLED=1                # Silero VAD (needs backend/requirements-voice.txt)
VOICE_LOCAL_ASR_ENABLED=0          # IndicConformer-600M on this machine (hi/or; model downloaded explicitly)
VOICE_LOCAL_MODEL_DIR=./models/voice
VOICE_CLOUD_STT_ENABLED=0          # Sarvam Saaras v4 — also needs per-case `voice_cloud` consent
VOICE_TTS_ENABLED=0                # Sarvam Bulbul v3 spoken read-back — also needs `voice_cloud` consent
VOICE_MAX_SECONDS=30
# Sarvam may retain content up to 30 days and use it for training unless your organisation opts out
# (check your Sarvam dashboard). Use synthetic audio only in this prototype.
SARVAM_API_KEY=your_sarvam_api_key_here
# Must be https://api.sarvam.ai (allowlisted in backend/app/config.py); anything else refuses to start.
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_S=20

# --- Authentication ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_PATH=./sehat.db

# --- CORS & Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OCR Pipeline (optional) ---
OCR_ENABLED=0
OCR_SURYA_ENABLED=0
OCR_CHANDRA_ENABLED=0
OCR_RETENTION_DAYS=none

# --- Medical image description (optional; docs/18_Medical_Image_Pipeline.md) ---
# Describes visual findings on chest X-ray / ECG / CT / wound / skin photos. NOT a diagnosis. Needs OCR_ENABLED=1.
# MEDGEMMA_BACKEND: fake (canned offline outputs, not a model) | google_ai (Gemini; backend/requirements-medgemma.txt)
#                   local (MedGemma 1.5 4B on THIS machine via the OCR worker; install with
#                          backend/scripts/download_medgemma_local.py after accepting the model terms; needs AI-assist
#                          consent; ECG is never sent; not a validated medical device; docs/18 §4a)
#                   | azure (Azure OpenAI vision deployment = AZURE_OPENAI_DEPLOYMENT_NAME; uses the AZURE_OPENAI_* settings)
# Cloud backends (google_ai, azure) send the image off this machine: they also require AI_CLOUD_ENABLED=1 and
# AI_CLOUD_SYNTHETIC_DATA_ONLY=1 (synthetic/demo images only), and each upload needs ai_assist consent plus
# synthetic_attestation=true. There is never a fallback between backends.
MEDGEMMA_ENABLED=0
# MEDGEMMA_BACKEND=fake
# MEDGEMMA_MODEL=gemini-3.8-flash     # google_ai only; azure uses AZURE_OPENAI_DEPLOYMENT_NAME
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here
# MEDGEMMA_TIMEOUT_S=30

# --- Facility isolation (docs/17 §8; dev/test demo accounts only) ---
# Trusted server-side mapping of demo account → facility codes it may access. Unset/blank = isolation OFF
# (every account sees every facility). When set, an account missing from the mapping gets NO case access.
# Format: username=CODE[,CODE...] or username=*  (unrestricted), entries separated by ';'. Codes must match
# ^[A-Z0-9-]{3,32}$; unknown accounts or malformed entries refuse to start.
# ACCOUNT_FACILITIES=anm_demo=PHC-KHURDA-01;mo_demo=PHC-KHURDA-01;supervisor_demo=*;patient_demo=PHC-KHURDA-01
